#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawIndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

struct ObjectData
{
    vec4 boundingSphere;  // xyz: center, w: radius
    uint transformIndex;
    uint drawCommandIndex;
    uint padding[2];
};

layout(set = 0, binding = 0) uniform CullData
{
    mat4 view;
    mat4 proj;
    vec4 frustumPlanes[6];
    vec2 screenSize;
    uint drawCount;
    uint hiZMipLevels;
    uint enableOcclusionCulling;
    uint padding[2];
} cullData;

layout(set = 0, binding = 1) readonly buffer ObjectDataBuffer { ObjectData objects[]; };
layout(set = 0, binding = 2) readonly buffer TransformBuffer { mat4 transforms[]; };
layout(set = 0, binding = 3) writeonly buffer InstanceBuffer { uint IDs[]; };
layout(set = 0, binding = 4) buffer DrawCommands 
{ 
    DrawIndexedIndirectCommand commands[];
};
layout(set = 0, binding = 5) uniform sampler2D hiZBuffer;

// Buffers to use the pass 2
layout(set = 0, binding = 10) buffer RejectedIndicesBuffer { uint rejectedIndices[]; };
layout(set = 0, binding = 11) buffer RejectedCountBuffer { uint rejectedCount; };

bool IsOccluded(vec3 worldCenter, float worldRadius)
{
    // Transform to clip space
    vec4 clipCenter = cullData.proj * cullData.view * vec4(worldCenter, 1.0);
    
    // Behind camera - let frustum culling handle it
    if (clipCenter.w <= 0.0)
        return false;
    
    // NDC coordinates
    vec3 ndc = clipCenter.xyz / clipCenter.w;
    
    // Screen UV [0, 1]
    vec2 screenUV = ndc.xy * 0.5 + 0.5;
    
    // Outside screen - let frustum culling handle it
    if (any(lessThan(screenUV, vec2(0.0))) || any(greaterThan(screenUV, vec2(1.0))))
        return false;
    
    // Calculate screen space radius
    float projRadius = worldRadius * cullData.proj[1][1] / clipCenter.w;
    float screenPixelRadius = projRadius * cullData.screenSize.y * 0.5;
    
    // Select appropriate mip level based on screen size
    int mipLevel = int(ceil(log2(max(screenPixelRadius * 2.0, 1.0))));
    mipLevel = clamp(mipLevel, 0, int(cullData.hiZMipLevels) - 1);
    
    // Sample Hi-Z buffer
    float occluderDepth = textureLod(hiZBuffer, screenUV, float(mipLevel)).r;
    
    // Object's nearest depth (front of sphere)
    float objectNearZ = clipCenter.z - worldRadius;
    float objectNearDepth = objectNearZ / clipCenter.w;
    objectNearDepth = objectNearDepth * 0.5 + 0.5;  // Convert to [0, 1]
    
    // Object is occluded if its nearest point is behind the occluder
    return objectNearDepth > occluderDepth;
}

bool IsVisibleFrustum(vec3 center, float radius)
{
    for (int i = 0; i < 6; ++i)
    {
        float distance = dot(cullData.frustumPlanes[i].xyz, center) + cullData.frustumPlanes[i].w;
        if (distance < -radius)
        {
            return false;
        }
    }
    return true;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= rejectedCount)
        return;

    uint objectIndex = rejectedIndices[index];
    ObjectData obj = objects[objectIndex];
    uint cmdIndex = obj.drawCommandIndex;

    // Get world transform matrix
    mat4 worldMatrix = transforms[obj.transformIndex];

    // Transform bounding sphere center to world space
    vec3 worldCenter = (worldMatrix * vec4(obj.boundingSphere.xyz, 1.0)).xyz;

    // Scale radius by maximum scale factor
    vec3 scale = vec3(
        length(worldMatrix[0].xyz),
        length(worldMatrix[1].xyz),
        length(worldMatrix[2].xyz)
    );
    float maxScale = max(max(scale.x, scale.y), scale.z);
    float worldRadius = obj.boundingSphere.w * maxScale;

    if (!IsVisibleFrustum(worldCenter, worldRadius))
        return;
    if (IsOccluded(worldCenter, worldRadius))
        return;

    // Add it to Pass2 draw command
    uint localIdx = atomicAdd(commands[cmdIndex].instanceCount, 1);
    IDs[commands[cmdIndex].firstInstance + localIdx] = obj.transformIndex;
}