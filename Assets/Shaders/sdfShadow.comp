#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "sdfCommon.glsl"
#include "Terrain/terrainCommon.glsl"

layout(set = 0, binding = 0) uniform CameraUniform
{
    mat4 view;
    mat4 proj;
    vec3 pos;
} camera;

layout(set = 0, binding = 1) uniform sampler3D sdfVolume;

layout(set = 0, binding = 2) uniform SDFParams
{
    vec4 lightDirection;   // normalized dir (w: softness)
    vec4 volumeResolution; // xyz: res, w: max march distance
    int  maxSteps;
    float minDistance;
    float maxDistance;
    float shadowSoftness;
    float paddingFactor;
    float sdfTransitionDistance;
    float sdfTransitionRange;
    float pad0;
    vec4 terrainShadow;    // x: max distance, y: softness, z: bias, w: steps (0 = off)
} sdf;

layout(set = 0, binding = 3) uniform sampler2D depthTexture;
layout(set = 0, binding = 4, r8) uniform writeonly image2D shadowOutput;
layout(set = 0, binding = 5) readonly buffer SDFBoundsBuffer { uint rawBounds[8]; };

// The terrain heightfield
layout(set = 0, binding = 6) uniform usampler2D terrainQuadTreeIndex;
layout(set = 0, binding = 7) uniform sampler2D terrainHeightAtlas;
layout(set = 0, binding = 8) uniform TerrainParamsUniform { TerrainParams terrain; };

vec3 ReconstructWorldPos(vec2 uv, float depth)
{
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    mat4 invViewProj = inverse(camera.proj * camera.view);
    vec4 worldPos = invViewProj * clipPos;
    return worldPos.xyz / worldPos.w;
}

vec3 WorldToVolumeUV(vec3 worldPos, vec3 boundsMin, vec3 boundsMax)
{
    return (worldPos - boundsMin) / (boundsMax - boundsMin);
}

float SDFSoftShadow(vec3 origin, vec3 dir, float tMin, float tMax, float k,
                    vec3 boundsMin, vec3 boundsMax, float voxelSize)
{
    float result = 1.0;
    float t = tMin;
    float ph = 1e20;

    for (int i = 0; i < sdf.maxSteps && t < tMax; ++i)
    {
        vec3 pos = origin + dir * t;
        vec3 uvw = WorldToVolumeUV(pos, boundsMin, boundsMax);

        if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))))
            break;

        float dist = texture(sdfVolume, uvw).r;

        // signed SDF: inside mesh = fully shadowed
        if (dist < -sdf.minDistance)
            return 0.0;

        float absDist = abs(dist);

        if (absDist < sdf.minDistance)
            return 0.0;

        // IQ improved soft shadow (parabolic closest-approach estimate)
        float y = absDist * absDist / (2.0 * ph);
        float d = sqrt(max(0.0, absDist * absDist - y * y));

        // Clamp d to voxel resolution.
        // Geometry thinner than a voxel reports near-zero d,
        // but physically can't cast a shadow sharper than the voxel footprint.
        // This prevents thin/distant geometry from forming a wide dark cone
        // while thick geometry (many steps with small d) still accumulates correctly.
        float dResolved = max(d, voxelSize);

        result = min(result, k * dResolved / max(0.0001, t - y));
        ph = absDist;

        // Minimum step = half voxel size.
        // Prevents sub-voxel oscillation near thin geometry that causes
        // the fish-bone stripe artifact.
        t += max(absDist, voxelSize * 0.5);
    }

    return clamp(result, 0.0, 1.0);
}

// Soft shadow from the terrain heightfield: march toward the light with
// geometrically growing steps and treat the ray's clearance above the
// terrain as the occluder distance. 
// Ends once the ray clears the world's height range or leaves the world.
float TerrainHeightfieldShadow(vec3 origin, vec3 dir)
{
    int steps = int(sdf.terrainShadow.w);
    if (steps == 0 || dir.y <= 0.0)
        return 1.0;

    float maxDistance = sdf.terrainShadow.x;
    float k = sdf.terrainShadow.y;
    float bias = sdf.terrainShadow.z;
    float heightMax = terrain.heightMinMaxInvAtlas.y;

    const float FIRST_STEP = 1.0;
    float growth = pow(max(maxDistance, FIRST_STEP * 2.0) / FIRST_STEP, 1.0 / float(steps));

    // Start on the sampled heightfield, not the rasterized depth: the depth
    // position carries its own quantization and bilinear-vs-triangle error,
    // which against a sub-metre penumbra reads as noise. Anything within
    // GROUND_TOLERANCE of the ground is ground; higher points (meshes) keep
    // their height.
    const float GROUND_TOLERANCE = 4.0;
    float groundHeight;
    if (TerrainSampleHeight(terrainQuadTreeIndex, terrainHeightAtlas, terrain, origin.xz, groundHeight)
        && origin.y < groundHeight + bias + GROUND_TOLERANCE)
        origin.y = groundHeight + bias;

    float result = 1.0;
    float t = FIRST_STEP;
    for (int i = 0; i < steps; ++i)
    {
        vec3 pos = origin + dir * t;
        if (pos.y > heightMax)
            break;

        float height;
        if (!TerrainSampleHeight(terrainQuadTreeIndex, terrainHeightAtlas, terrain, pos.xz, height))
            break;

        float clearance = pos.y - height;
        if (clearance < 0.0)
            return 0.0;

        result = min(result, k * clearance / t);
        t *= growth;
    }

    return clamp(result, 0.0, 1.0);
}

void main()
{
    ivec2 outputSize = imageSize(shadowOutput);
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoord.x >= outputSize.x || pixelCoord.y >= outputSize.y)
        return;

    vec3 boundsMin, boundsMax;
    sdfDecodeBounds(rawBounds, sdf.paddingFactor, boundsMin, boundsMax);

    // One full-res depth texel per mask pixel: filtering depth across a
    // silhouette would average two surfaces into a position in mid-air.
    ivec2 depthCoord = pixelCoord * 2;
    vec2 uv = (vec2(depthCoord) + 0.5) / vec2(textureSize(depthTexture, 0));
    float depth = texelFetch(depthTexture, depthCoord, 0).r;

    if (depth >= 1.0)
    {
        imageStore(shadowOutput, pixelCoord, vec4(1.0));
        return;
    }

    vec3 worldPos = ReconstructWorldPos(uv, depth);

    // Distance-based CSM/SDF split: skip SDF shadow for pixels within CSM range.
    // Compute view-space depth (linear depth from camera).
    vec3 viewPos = (camera.view * vec4(worldPos, 1.0)).xyz;
    float viewDepth = -viewPos.z;  // view-space Z is negative in front of camera
    
    // If within transition distance, output full light (no SDF shadow).
    // CSM handles these pixels.
    if (viewDepth < sdf.sdfTransitionDistance)
    {
        imageStore(shadowOutput, pixelCoord, vec4(1.0));
        return;
    }
    
    vec3 lightDir = normalize(-sdf.lightDirection.xyz);

    vec3 volumeSize = boundsMax - boundsMin;
    float voxelSize = max(volumeSize.x, max(volumeSize.y, volumeSize.z))
                      / sdf.volumeResolution.x;
    float tMin = voxelSize * 2.0;

    float shadow = SDFSoftShadow(worldPos, lightDir,
        tMin, sdf.maxDistance, sdf.shadowSoftness,
        boundsMin, boundsMax, voxelSize);

    shadow = min(shadow, TerrainHeightfieldShadow(worldPos, lightDir));

    imageStore(shadowOutput, pixelCoord, vec4(shadow, shadow, shadow, 1.0));
}