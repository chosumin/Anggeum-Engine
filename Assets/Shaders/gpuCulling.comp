#version 450

#define GPU_DRIVEN_CULL
#include "gpuDriven.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 1) readonly buffer InstanceDataBuffer { InstanceData instances[]; };
layout(set = 0, binding = 2) readonly buffer TransformBuffer { mat4 transforms[]; };
layout(set = 0, binding = 3) writeonly buffer InstanceIDBuffer { uint instanceIDs[]; };
// The shared command template: read-only, per-command counts go to binding 6.
layout(set = 0, binding = 4) readonly buffer DrawCommands { DrawIndexedIndirectCommand commands[]; };
layout(set = 0, binding = 5) uniform sampler2D hiZBuffer;
layout(set = 0, binding = 6) buffer InstanceCounts { uint counts[]; };

// Pass 2 re-tests these against this frame's depth.
layout(set = 0, binding = 10) buffer RejectedIndicesBuffer { uint rejectedIndices[]; };
layout(set = 0, binding = 11) buffer RejectedCountBuffer { uint rejectedCount; };

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= cullData.drawCount)
        return;

    InstanceData inst = instances[index];
    if (inst.drawCommandIndex == DEAD_DRAW)
        return;

    vec3 worldMin;
    vec3 worldMax;
    InstanceWorldAABB(inst, transforms[inst.transformIndex], worldMin, worldMax);

    bool visible = IsVisibleFrustum(cullData.frustumPlanes, worldMin, worldMax);
    if (visible && cullData.enableOcclusionCulling == 1)
        visible = !IsOccluded(hiZBuffer, cullData.proj * cullData.view,
            cullData.screenSize, cullData.hiZMipLevels, worldMin, worldMax);

    uint cmdIndex = inst.drawCommandIndex;
    if (visible)
    {
        uint localIdx = atomicAdd(counts[cmdIndex], 1);
        instanceIDs[commands[cmdIndex].firstInstance + localIdx] = index;
    }
    else
    {
        uint rejIdx = atomicAdd(rejectedCount, 1);
        rejectedIndices[rejIdx] = index;
    }
}
