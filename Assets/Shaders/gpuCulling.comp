#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DrawIndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

struct ObjectData
{
    vec4 boundingSphere;  // xyz: center, w: radius
    uint transformIndex;
    uint padding[3];
};

layout(set = 0, binding = 0) uniform CullData
{
    vec4 frustumPlanes[6];
    uint drawCount;
    uint padding[3];
} cullData;

layout(set = 0, binding = 1) readonly buffer ObjectDataBuffer
{
    ObjectData objects[];
};

layout(set = 0, binding = 2) readonly buffer TransformBuffer
{
    mat4 transforms[];
};

layout(set = 0, binding = 3) writeonly buffer InstanceBuffer
{
    uint IDs[];
};

layout(set = 0, binding = 4) writeonly buffer DrawCommands
{
    DrawIndexedIndirectCommand commands[];
};

layout(set = 0, binding = 5) buffer DrawCount
{
    uint drawCount;
};

bool IsVisibleFrustum(vec3 center, float radius)
{
    for (int i = 0; i < 6; ++i)
    {
        float distance = dot(cullData.frustumPlanes[i].xyz, center) + cullData.frustumPlanes[i].w;
        if (distance < -radius)
        {
            return false;
        }
    }
    return true;
}

void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= cullData.drawCount)
        return;

    ObjectData obj = objects[index];
    
    // Get world transform matrix
    mat4 worldMatrix = transforms[obj.transformIndex];

    // Transform bounding sphere center to world space
    vec3 worldCenter = (worldMatrix * vec4(obj.boundingSphere.xyz, 1.0)).xyz;

    // Scale radius by maximum scale factor
    vec3 scale = vec3(
        length(worldMatrix[0].xyz),
        length(worldMatrix[1].xyz),
        length(worldMatrix[2].xyz)
    );
    float maxScale = max(max(scale.x, scale.y), scale.z);
    float worldRadius = obj.boundingSphere.w * maxScale;

    bool visible = true;

    // Frustum culling
    visible = IsVisibleFrustum(worldCenter, worldRadius);

    if (visible)
    {
        uint outputIndex = atomicAdd(drawCount, 1);
        IDs[outputIndex] = obj.transformIndex;
        commands[index].instanceCount = 1;
    }
    else
    {
        // Make zero out the draw command to avoid rendering
        commands[index].instanceCount = 0;
    }
}