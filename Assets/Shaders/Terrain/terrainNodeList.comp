#version 450

// Builds the Terrain Node List: the covering set of resident quadtree
// nodes for this frame. Single dispatch, single workgroup; levels are walked
// root-down with the intermediate lists ping-ponged through shared memory, so
// no per-level dispatch or indirect-args round trips are needed.

layout(local_size_x = 256) in;

#include "terrainCommon.glsl"

layout(set = 0, binding = 0) uniform usampler2D quadTreeIndex;

// uvec2 per node: x = packed coord (see terrainCommon), y = atlas slot.
layout(set = 0, binding = 1) writeonly buffer NodeList
{
    uvec2 entries[];
} nodeList;

// Doubles as the VkDispatchIndirectCommand for downstream one-group-per-node
// passes (the LOD map fill dispatches indirectly from offset 4). `coherent`:
// thread 0 reads the atomically-built count back with a plain load at the
// end; barrier() alone orders shared memory, not SSBOs.
layout(set = 0, binding = 2) coherent buffer NodeListCount
{
    uint count;
    uint groupsX;
    uint groupsY;
    uint groupsZ;
} nodeCount;

layout(push_constant) uniform Push
{
    vec2 cameraXZ;
    vec2 worldOrigin;
    float rootNodeSize;
    float ringRadiusScale;
    uint lodCount;
    uint rootTiles;
} push;

// Bounded by the atlas capacity: every listed node is resident, so a level
// list can never exceed the number of atlas slots.
layout(constant_id = 0) const uint MAX_NODES = 512u;

// The 4-bit lod field in the packed coord bounds the level count.
const uint MAX_LODS = 16u;

// The lists ping-pong (space), but each level gets its OWN counter 
// so one barrier per level suffices.
shared uint lists[2][MAX_NODES];
shared uint levelCounts[MAX_LODS + 1u];

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint rootCount = push.rootTiles * push.rootTiles;

    if (tid <= MAX_LODS)
        levelCounts[tid] = 0u;
    if (tid == 0u)
    {
        nodeCount.count = 0u;
        levelCounts[0] = rootCount;
    }
    if (tid < rootCount)
        lists[0][tid] = TerrainPackCoord(push.lodCount - 1u,
            uvec2(tid % push.rootTiles, tid / push.rootTiles));
    barrier();

    for (uint level = 0u; level < push.lodCount; ++level)
    {
        uint readIdx = level & 1u;
        uint writeIdx = 1u - readIdx;
        uint lod = push.lodCount - 1u - level;

        // The only consumer of this level's counter, so the overflow clamp
        // lives here (reserve-then-check appends may inflate it). Hoisted
        // into a register: the loop's atomicAdds would otherwise force a
        // shared reload every iteration.
        uint levelCount = min(levelCounts[level], MAX_NODES);

        for (uint i = tid; i < levelCount; i += gl_WorkGroupSize.x)
        {
            uint packedCoord = lists[readIdx][i];
            uvec2 coord = TerrainUnpackCoord(packedCoord);

            // Shared predicate (terrainCommon): same radii the streamer
            // requests with, and the exact rule the LOD map walk uses.
            bool subdivided = false;
            if (TerrainShouldRefine(quadTreeIndex, lod, coord,
                push.cameraXZ, push.worldOrigin, push.rootNodeSize,
                push.ringRadiusScale, push.lodCount))
            {
                uvec2 childBase = coord * 2u;
                uint dst = atomicAdd(levelCounts[level + 1u], 4u);
                if (dst + 4u <= MAX_NODES)
                {
                    lists[writeIdx][dst + 0u] = TerrainPackCoord(lod - 1u, childBase);
                    lists[writeIdx][dst + 1u] = TerrainPackCoord(lod - 1u, childBase + uvec2(1u, 0u));
                    lists[writeIdx][dst + 2u] = TerrainPackCoord(lod - 1u, childBase + uvec2(0u, 1u));
                    lists[writeIdx][dst + 3u] = TerrainPackCoord(lod - 1u, childBase + uvec2(1u, 1u));
                }
                subdivided = true;
            }

            if (!subdivided)
            {
                uint slot = texelFetch(quadTreeIndex, ivec2(coord), int(lod)).r;
                if (slot < TERRAIN_NODE_INVALID) // not resident: parent already covers
                {
                    uint dst = atomicAdd(nodeCount.count, 1u);
                    if (dst < MAX_NODES)
                        nodeList.entries[dst] = uvec2(packedCoord, slot);
                }
            }
        }

        barrier();
    }

    if (tid == 0u)
    {
        uint total = min(nodeCount.count, MAX_NODES);
        nodeCount.count = total;

        // Indirect args for the one-group-per-node consumers.
        nodeCount.groupsX = total;
        nodeCount.groupsY = 1u;
        nodeCount.groupsZ = 1u;
    }
}
