#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputDepth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D outputDepth;

layout(push_constant) uniform PushConstants
{
    ivec2 outputSize;
} pushConstants;

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    
    if (pos.x >= pushConstants.outputSize.x || pos.y >= pushConstants.outputSize.y)
        return;
    
    ivec2 srcPos = pos * 2;
    
    // Sample 2x2 block and take maximum (furthest) depth
    float d0 = texelFetch(inputDepth, srcPos + ivec2(0, 0), 0).r;
    float d1 = texelFetch(inputDepth, srcPos + ivec2(1, 0), 0).r;
    float d2 = texelFetch(inputDepth, srcPos + ivec2(0, 1), 0).r;
    float d3 = texelFetch(inputDepth, srcPos + ivec2(1, 1), 0).r;
    
    float maxDepth = max(max(d0, d1), max(d2, d3));
    
    imageStore(outputDepth, pos, vec4(maxDepth, 0.0, 0.0, 0.0));
}