#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputDepth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D outputDepth;

layout(push_constant) uniform PushConstants
{
    ivec2 outputSize;
} pushConstants;

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);

    if (pos.x >= pushConstants.outputSize.x || pos.y >= pushConstants.outputSize.y)
        return;

    // Farthest depth of the source block. An odd source axis (non-pow2
    // screens) reads 3 texels there, so every texel a uv lookup of this level
    // can land on is covered and the last row/column is never dropped.
    ivec2 srcSize = textureSize(inputDepth, 0);
    ivec2 srcPos = pos * 2;
    ivec2 span = ivec2(2) + (srcSize & 1);

    float maxDepth = 0.0;
    for (int y = 0; y < span.y; ++y)
        for (int x = 0; x < span.x; ++x)
            maxDepth = max(maxDepth,
                texelFetch(inputDepth, min(srcPos + ivec2(x, y), srcSize - 1), 0).r);

    imageStore(outputDepth, pos, vec4(maxDepth, 0.0, 0.0, 0.0));
}
