#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "sdfCommon.glsl"

#define PI 3.14159265358979

struct TriLookup
{
    int  vertexOffset;
    uint transformIndex;
};

layout(push_constant) uniform PushConstants
{
    uint resolution;
    uint triangleCount;
    float paddingFactor;
    uint useUint16Indices; // 0 = uint32, 1 = uint16
} pc;

layout(set = 0, binding = 0) readonly buffer PositionBuffer { float positions[]; };
layout(set = 0, binding = 1) readonly buffer IndexBuffer { uint indexData[]; };
layout(set = 0, binding = 2, r32f) uniform writeonly image3D sdfVolume;
layout(set = 0, binding = 3) readonly buffer SDFBoundsBuffer { uint rawBounds[8]; };
layout(set = 0, binding = 4) readonly buffer TriLookupBuffer { TriLookup triLookups[]; };
layout(set = 0, binding = 5) readonly buffer TransformBuffer { mat4 transforms[]; };

// Read index correctly based on index type (uint16 or uint32)
uint LoadIndex(uint idx)
{
    if (pc.useUint16Indices != 0)
    {
        // 2 uint16 indices packed per uint32
        uint wordIndex = idx / 2;
        uint word = indexData[wordIndex];
        return (idx % 2 == 0) ? (word & 0xFFFFu) : (word >> 16);
    }
    else
    {
        return indexData[idx];
    }
}

vec3 LoadPosition(int vertexOffset, uint localIndex)
{
    uint globalIndex = uint(int(localIndex) + vertexOffset);
    return vec3(
        positions[globalIndex * 3 + 0],
        positions[globalIndex * 3 + 1],
        positions[globalIndex * 3 + 2]
    );
}

float PointTriangleDistance(vec3 p, vec3 v0, vec3 v1, vec3 v2, out vec3 closestPoint)
{
    vec3 edge0 = v1 - v0;
    vec3 edge1 = v2 - v0;
    vec3 v0p = v0 - p;

    float a = dot(edge0, edge0);
    float b = dot(edge0, edge1);
    float c = dot(edge1, edge1);
    float d = dot(edge0, v0p);
    float e = dot(edge1, v0p);

    float det = a * c - b * b;
    float s = b * e - c * d;
    float t = b * d - a * e;

    if (s + t <= det)
    {
        if (s < 0.0)
        {
            if (t < 0.0)
            {
                if (d < 0.0) { s = clamp(-d / a, 0.0, 1.0); t = 0.0; }
                else { s = 0.0; t = clamp(-e / c, 0.0, 1.0); }
            }
            else { s = 0.0; t = clamp(-e / c, 0.0, 1.0); }
        }
        else if (t < 0.0) { s = clamp(-d / a, 0.0, 1.0); t = 0.0; }
        else { float invDet = 1.0 / det; s *= invDet; t *= invDet; }
    }
    else
    {
        if (s < 0.0)
        {
            float tmp0 = b + d;
            float tmp1 = c + e;
            if (tmp1 > tmp0) { float n = tmp1 - tmp0; float dn = a - 2.0*b + c; s = clamp(n/dn, 0.0, 1.0); t = 1.0 - s; }
            else { s = 0.0; t = clamp(-e / c, 0.0, 1.0); }
        }
        else if (t < 0.0)
        {
            float tmp0 = b + e;
            float tmp1 = a + d;
            if (tmp1 > tmp0) { float n = tmp1 - tmp0; float dn = a - 2.0*b + c; t = clamp(n/dn, 0.0, 1.0); s = 1.0 - t; }
            else { s = clamp(-d / a, 0.0, 1.0); t = 0.0; }
        }
        else
        {
            float n = (c + e) - (b + d);
            if (n <= 0.0) { s = 0.0; }
            else { float dn = a - 2.0*b + c; s = clamp(n/dn, 0.0, 1.0); }
            t = 1.0 - s;
        }
    }

    closestPoint = v0 + s * edge0 + t * edge1;
    return length(p - closestPoint);
}

// Signed solid angle of triangle (a,b,c) seen from origin.
// Van Oosterom & Strackee (1983), numerically stable form.
float SolidAngleAtOrigin(vec3 a, vec3 b, vec3 c)
{
    float la = length(a);
    float lb = length(b);
    float lc = length(c);

    // Degenerate: point coincides with a vertex -> contribute 0
    if (la < 1e-12 || lb < 1e-12 || lc < 1e-12)
        return 0.0;

    float numer = dot(a, cross(b, c));
    float denom = la * lb * lc
                + dot(a, b) * lc
                + dot(b, c) * la
                + dot(c, a) * lb;

    return 2.0 * atan(numer, denom);
}

void main()
{
    uvec3 voxelCoord = gl_GlobalInvocationID.xyz;

    if (any(greaterThanEqual(voxelCoord, uvec3(pc.resolution))))
        return;

    vec3 boundsMin, boundsMax;
    sdfDecodeBounds(rawBounds, pc.paddingFactor, boundsMin, boundsMax);

    vec3 volumeSize = boundsMax - boundsMin;
    vec3 voxelSize = volumeSize / float(pc.resolution);
    vec3 worldPos = boundsMin + (vec3(voxelCoord) + 0.5) * voxelSize;

    float minDist = 1e20;
    float windingSum = 0.0; // generalized winding number * 4*PI

    for (uint tri = 0; tri < pc.triangleCount; ++tri)
    {
        TriLookup lookup = triLookups[tri];

        uint i0 = LoadIndex(tri * 3 + 0);
        uint i1 = LoadIndex(tri * 3 + 1);
        uint i2 = LoadIndex(tri * 3 + 2);

        vec3 v0 = LoadPosition(lookup.vertexOffset, i0);
        vec3 v1 = LoadPosition(lookup.vertexOffset, i1);
        vec3 v2 = LoadPosition(lookup.vertexOffset, i2);

        mat4 worldMatrix = transforms[lookup.transformIndex];
        v0 = (worldMatrix * vec4(v0, 1.0)).xyz;
        v1 = (worldMatrix * vec4(v1, 1.0)).xyz;
        v2 = (worldMatrix * vec4(v2, 1.0)).xyz;

        // unsigned distance (still uses single closest)
        vec3 closest;
        float dist = PointTriangleDistance(worldPos, v0, v1, v2, closest);
        minDist = min(minDist, dist);

        // robust sign via generalized winding number
        windingSum += SolidAngleAtOrigin(v0 - worldPos, v1 - worldPos, v2 - worldPos);
    }

    // winding number ~ 1 inside, ~ 0 outside (for a closed mesh)
    float windingNumber = windingSum * (1.0 / (4.0 * PI));
    float sgn = (windingNumber > 0.5) ? -1.0 : 1.0;

    imageStore(sdfVolume, ivec3(voxelCoord), vec4(sgn * minDist));
}